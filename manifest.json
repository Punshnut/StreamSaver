{
  "manifest_version": 3,
  "name": "StreamSaver",
  "version": "0.2.1",
  "description": "fast and reliable controlling of Twitch stream quality - follow project on github: https://github.com/Punshnut/StreamSaver",
  "action": {
    "default_title": "StreamSaver",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
